<?xml version="1.0" encoding="utf-8"?>
<!-- The Todos home-screen widget; merged into the app manifest and deleted with the feature. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.primestrider.kotlinstarter.feature.example.todos.widget.TodosWidgetReceiver"
            android:exported="true"
            android:label="@string/todos_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todos_widget_info" />
        </receiver>
    </application>

</manifest>
