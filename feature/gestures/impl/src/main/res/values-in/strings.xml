    <string name="gesture_scroll_dial_usage">Ubah delta gulir menjadi nilai sendiri, seperti dial, wheel picker, atau zoom. Ia ikut nested scrolling, jadi halaman lanjut menggulir di 0 dan 100.</string>
    <string name="gesture_scroll_dial_value">Nilai: %1$d</string>
    <string name="gesture_scroll_dial_increase">Naikkan</string>
    <string name="gesture_scroll_dial_decrease">Turunkan</string>
