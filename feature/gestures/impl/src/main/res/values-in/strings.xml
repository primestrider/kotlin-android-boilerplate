    <string name="gesture_scroll_nested_usage">Header yang menyusut sebelum daftar menggulir dan kembali saat daftar sudah di atas, seperti perilaku halaman profil dan detail.</string>
    <string name="gesture_scroll_nested_header">Header menyusut</string>
    <string name="gesture_scroll_row">Baris %1$d</string>
