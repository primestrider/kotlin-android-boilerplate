<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. The encrypted session is bound to a device Keystore key and must not be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
